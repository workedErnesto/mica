<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SharedDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../shared/'))</SharedDir>
    <MicaVersion>$([System.IO.File]::ReadAllText('$(SharedDir)version.txt').Trim())</MicaVersion>
    <Version>$(MicaVersion)</Version>
    <Company>mica</Company>
    <Product>mica</Product>
    <Copyright>mica</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Mica.Setup' Or '$(MSBuildProjectName)' == 'Mica.App'">
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>
</Project>
