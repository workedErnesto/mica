<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Dotnet.props" />
  <PropertyGroup>
    <TargetFramework>$(MicaDotnet)</TargetFramework>
    <RootNamespace>Mica.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(SharedDir)strings/en.txt" LogicalName="mica.en.txt" />
    <EmbeddedResource Include="$(SharedDir)keymap.json" LogicalName="mica.keymap.json" />
    <EmbeddedResource Include="$(SharedDir)glyphs.json" LogicalName="mica.glyphs.json" />
    <EmbeddedResource Include="$(SharedDir)blocklist/blocklist.txt" LogicalName="mica.blocklist.txt" />
  </ItemGroup>
</Project>
