{
  "$comment": "Keyboard commands of mica. macos lists the menu key equivalents in macos/Sources/MicaApp/App/AppDelegate.swift, windows is read by windows/src/Mica.App at startup. Windows keeps Chrome and Edge habits where they differ from macOS. Keys: Ctrl, Shift, Alt, Win, then a key name from Windows.System.VirtualKey or a single character.",
  "commands": {
    "tab":        { "macos": ["Cmd+T"], "windows": ["Ctrl+T"] },
    "newWindow":  { "macos": ["Cmd+N"], "windows": ["Ctrl+N"] },
    "private":    { "macos": ["Cmd+Shift+N"], "windows": ["Ctrl+Shift+N"] },
    "close":      { "macos": ["Cmd+W"], "windows": ["Ctrl+W", "Ctrl+F4"] },
    "reopen":     { "macos": ["Cmd+Shift+T"], "windows": ["Ctrl+Shift+T"] },
    "save":       { "macos": ["Cmd+S"], "windows": ["Ctrl+S"] },
    "print":      { "macos": ["Cmd+P"], "windows": ["Ctrl+P"] },
    "find":       { "macos": ["Cmd+F"], "windows": ["Ctrl+F"] },
    "findNext":   { "macos": ["Cmd+G"], "windows": ["F3", "Ctrl+G"] },
    "findPrevious": { "macos": ["Cmd+Shift+G"], "windows": ["Shift+F3", "Ctrl+Shift+G"] },
    "zoomIn":     { "macos": ["Cmd+="], "windows": ["Ctrl+=", "Ctrl+Add"] },
    "zoomOut":    { "macos": ["Cmd+-"], "windows": ["Ctrl+-", "Ctrl+Subtract"] },
    "zoomReset":  { "macos": ["Cmd+0"], "windows": ["Ctrl+0", "Ctrl+NumberPad0"] },
    "devTools":   { "macos": ["Cmd+Alt+I"], "windows": ["F12", "Ctrl+Shift+I"] },
    "console":    { "macos": ["Cmd+Alt+C"], "windows": ["Ctrl+Shift+J"] },
    "sidebar":    { "macos": ["Ctrl+Cmd+S"], "windows": ["Ctrl+Shift+S"] },
    "fullscreen": { "macos": ["Ctrl+Cmd+F"], "windows": ["F11"] },
    "address":    { "macos": ["Cmd+L"], "windows": ["Ctrl+L", "Alt+D", "F6"] },
    "back":       { "macos": ["Cmd+["], "windows": ["Alt+Left", "XButton1"] },
    "forward":    { "macos": ["Cmd+]"], "windows": ["Alt+Right", "XButton2"] },
    "reload":     { "macos": ["Cmd+R"], "windows": ["Ctrl+R", "F5"] },
    "reloadHard": { "macos": ["Cmd+Shift+R"], "windows": ["Ctrl+Shift+R", "Ctrl+F5", "Shift+F5"] },
    "next":       { "macos": ["Ctrl+Tab", "Cmd+Shift+]", "Cmd+Alt+Right"], "windows": ["Ctrl+Tab", "Ctrl+PageDown"] },
    "previous":   { "macos": ["Ctrl+Shift+Tab", "Cmd+Shift+[", "Cmd+Alt+Left"], "windows": ["Ctrl+Shift+Tab", "Ctrl+PageUp"] },
    "bookmark":   { "macos": ["Cmd+D"], "windows": ["Ctrl+D"] },
    "history":    { "macos": ["Cmd+Y"], "windows": ["Ctrl+H"] },
    "clearData":  { "macos": ["Cmd+Shift+Delete"], "windows": ["Ctrl+Shift+Delete"] },
    "downloads":  { "macos": ["Cmd+Shift+J"], "windows": ["Ctrl+J"] },
    "extensions": { "macos": ["Cmd+Shift+E"], "windows": ["Ctrl+Shift+E"] },
    "settings":   { "macos": ["Cmd+,"], "windows": ["Ctrl+,"] },
    "customize":  { "macos": [], "windows": [] },
    "menu":       { "macos": [], "windows": ["Alt+F", "F10"] },
    "quit":       { "macos": ["Cmd+Q"], "windows": ["Ctrl+Shift+Q"] },
    "tab1": { "macos": ["Cmd+1"], "windows": ["Ctrl+1"] },
    "tab2": { "macos": ["Cmd+2"], "windows": ["Ctrl+2"] },
    "tab3": { "macos": ["Cmd+3"], "windows": ["Ctrl+3"] },
    "tab4": { "macos": ["Cmd+4"], "windows": ["Ctrl+4"] },
    "tab5": { "macos": ["Cmd+5"], "windows": ["Ctrl+5"] },
    "tab6": { "macos": ["Cmd+6"], "windows": ["Ctrl+6"] },
    "tab7": { "macos": ["Cmd+7"], "windows": ["Ctrl+7"] },
    "tab8": { "macos": ["Cmd+8"], "windows": ["Ctrl+8"] },
    "tabLast": { "macos": ["Cmd+9"], "windows": ["Ctrl+9"] }
  }
}
